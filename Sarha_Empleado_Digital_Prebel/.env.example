# Servidor
HOST=0.0.0.0
PORT=8000
DOCS_DIR=./docs
# Orígenes web permitidos para la landing-v3 (separados por coma). Agrega aquí el dominio de producción.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Modo del motor de respuestas:
#   local  -> RAG determinístico 100% offline/on-premise (no requiere API key)
#   gemini -> Síntesis con Google Gemini estrictamente acotada a docs/
#   openai -> Síntesis con OpenAI estrictamente acotada a docs/
#   ollama -> Síntesis con LLM local en servidor on-premise (Ollama)
LLM_PROVIDER=local

# Opcional (solo si LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opcional (solo si LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opcional (solo si LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Línea de prueba / Sandbox de Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
# Código de activación del Sandbox de Twilio (ej. "join bright-tiger")
TWILIO_SANDBOX_JOIN_CODE=
TWILIO_VALIDATE_SIGNATURE=false

# Integración futura Meta WhatsApp Cloud API (línea productiva)
WHATSAPP_VERIFY_TOKEN=prebel_gh_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
