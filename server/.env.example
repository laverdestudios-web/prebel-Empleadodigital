# --- LLM (uno de los dos) ---------------------------------------------------
GEMINI_API_KEY=
# GROQ_API_KEY=
# LLM_PROVIDER=gemini
# Fijar una versión concreta en lugar del alias "-latest" para que el
# comportamiento no cambie sin aviso.
LLM_MODEL=gemini-flash-lite-latest

# --- WhatsApp Cloud API (Meta for Developers > WhatsApp > Configuración) ----
# Token que tú inventas y registras en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret (Configuración de la app > Básica). Valida X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Token de acceso (permanente, de usuario del sistema) y Phone Number ID.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# Solo pruebas locales: acepta POST /webhook sin firma. Nunca en producción.
WEBHOOK_PERMITIR_SIN_FIRMA=0

# Página /prueba para chatear con el bot sin WhatsApp (sin autenticación y
# consume cuota del LLM). Solo en local o demo; 0 en producción.
CHAT_PRUEBAS=0
